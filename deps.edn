;; Spindle — small data flows (SQL + HTTP steps) published as APIs. EPL-2.0.
{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.939"}
        com.zaxxer/HikariCP {:mvn/version "5.1.0"}
        diehard/diehard {:mvn/version "0.12.1"}
        funcool/promesa {:mvn/version "12.0.1"}
        metosin/malli {:mvn/version "0.20.3"}
        metosin/reitit-core {:mvn/version "0.11.0"}
        metosin/jsonista {:mvn/version "1.0.2"}
        info.sunng/ring-jetty9-adapter {:mvn/version "0.40.6"}
        org.babashka/sci {:mvn/version "0.15.59"}
        com.github.ben-manes.caffeine/caffeine {:mvn/version "3.1.8"}
        io.micrometer/micrometer-registry-prometheus {:mvn/version "1.13.6"}
        org.clojure/tools.logging {:mvn/version "1.3.0"}
        org.slf4j/slf4j-simple {:mvn/version "2.0.16"}
        ;; bundled drivers (permissive licences)
        org.postgresql/postgresql {:mvn/version "42.7.4"}
        com.clickhouse/clickhouse-jdbc$all {:mvn/version "0.9.0"}}
 :aliases
 {:run  {:main-opts ["-m" "spindle.main"]}
  ;; MySQL/MariaDB driver for tests only — not part of a Spindle distribution (see drivers/README.md)
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      org.xerial/sqlite-jdbc {:mvn/version "3.46.1.3"}
                      org.mariadb.jdbc/mariadb-java-client {:mvn/version "3.5.3"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.5"}}
          :ns-default build}}}
